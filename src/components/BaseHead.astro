---
import { siteConfig } from "../data/site"

interface Props {
  title: string
  description?: string
  type?: "website" | "article"
  publishedTime?: Date
  author?: string
  standalone?: boolean
  /**
   * Absolute URL to a 1200x630 Open Graph "title card" image. When set, the
   * page advertises a large summary card (used for blog posts). When omitted,
   * pages fall back to the branded profile photo with a small summary card.
   */
  image?: string
}

const {
  title,
  description,
  type = "website",
  publishedTime,
  author,
  standalone,
  image,
} = Astro.props
const metaDescription = description || siteConfig.description
const pageTitle = standalone ? title : `${title} | ${siteConfig.title}`
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
// A generated title card is a large summary; the profile-photo fallback is a
// plain summary. LinkedIn and others require an absolute og:image URL.
const largeCard = Boolean(image)
const ogImage = image ?? new URL("/img/profile-pic.jpg", Astro.site).href
const twitterCard = largeCard ? "summary_large_image" : "summary"
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
{
  largeCard && (
    <>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="2400" />
      <meta property="og:image:height" content="1260" />
      <meta property="og:image:alt" content={title} />
    </>
  )
}
{
  type === "article" && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  type === "article" && author && (
    <meta property="article:author" content={author} />
  )
}
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:creator" content={siteConfig.social.twitter} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href="/favicon.ico" />

<!-- Structured data: Person schema helps search engines associate "John Gilday" with "Johnathan Gilday" -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteConfig.author.name,
    alternateName: siteConfig.author.altName,
    givenName: "John",
    familyName: "Gilday",
    url: siteConfig.siteUrl,
    sameAs: [
      `https://github.com/${siteConfig.social.github}`,
      `https://www.linkedin.com/in/${siteConfig.social.linkedIn}/`,
    ],
  })}
/>
